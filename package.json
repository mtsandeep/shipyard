{
  "name": "thakur-deploy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "dev": "bun run --filter '*' dev 2>&1 | tee debug.log",
    "generate": "bun run --filter '@thakur-deploy/control-api' generate",
    "migrate": "bun run --filter '@thakur-deploy/control-api' migrate",
    "lint": "bun lint",
    "format": "bun fmt",
    "prepare": "husky",
    "build": "NODE_ENV=production PLATFORM_ENV=production bun run --filter '*' build"
  },
  "devDependencies": {
    "bun-types": "latest",
    "fast-check": "^3.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^7.0.2",
    "vitest": "^1.0.0"
  }
}
