# ShipYard Docker runtime config (used by docker-compose.yml via env_file).
# Copy to .env.docker and fill in real values; .env.docker is gitignored.

# --- Auth ---
BETTER_AUTH_URL=http://localhost:4010
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:4013
DASHBOARD_ORIGIN=http://localhost:4013

# --- Security ---
# Encrypts project environment variables. Must be exactly 32 characters.
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=00000000000000000000000000000000

# --- GitHub OAuth (login via the "Continue with GitHub" button) ---
# Create an OAuth App at github.com/settings/developers with
# Authorization callback URL: http://localhost:4010/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Domains ---
# Local default; set to your real domain on a server (DNS via Cloudflare).
BASE_DOMAIN=localhost
SERVER_HOST=127.0.0.1
